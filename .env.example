# ── Required ──────────────────────────────────────────────────────────────────

# Google AI Studio API key for Gemini. Obtain at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# GCP project hosting the Firestore database (see `terraform -chdir=terraform output`).
GCP_PROJECT_ID=

# Spotify app credentials from the Spotify Developer Dashboard. Never commit them.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# OAuth redirect URI, registered exactly (trailing slash included) in the Spotify Dashboard.
# Locally always use the loopback IP: Spotify rejects http://localhost redirect URIs.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8501/

# Fernet key encrypting Spotify tokens at rest. Use a different key per environment:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=

# ── Optional (defaults shown) ─────────────────────────────────────────────────

# Firestore collection holding chat sessions (TTL policy on `expires_at`).
SESSIONS_COLLECTION=sessions

# Session lifetime in minutes after the last message (use 2 to test expiry locally).
SESSION_TTL_MINUTES=60

# Gemini model id.
LLM_MODEL=gemini-3.5-flash-lite

# Gemma model id of the intent gate, the fail-open out-of-scope filter in front of Gemini.
INTENT_MODEL=gemma-4-26b-a4b-it

# ISO 3166-1 alpha-2 country code for Spotify catalog search.
SPOTIFY_MARKET=IT

# Tracks when the user doesn't specify a size.
PLAYLIST_DEFAULT_SIZE=16

# Upper bound on playlist size: can be lowered, never raised above 30 (the minimum is 1).
PLAYLIST_MAX_SIZE=30

# Maximum chat messages per IP in any rate-limit window (sliding window).
RATE_LIMIT_MAX_REQUESTS=12

# Rate-limit window in seconds.
RATE_LIMIT_WINDOW=60

# Public URL of the deployed service, used by the smoke tests only.
CLOUD_RUN_URL=
