# Secrets only: every other setting lives in config/base.toml. Never commit the real .env.
# On Cloud Run the same three values come from Secret Manager.

# Google AI Studio API key for Gemini. Obtain at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Spotify app Client Secret from the Spotify Developer Dashboard.
SPOTIFY_CLIENT_SECRET=

# Fernet key encrypting Spotify tokens at rest. Use a different key per environment:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=
